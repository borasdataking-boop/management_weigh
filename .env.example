# ==============================================================================
# HỆ THỐNG CÂN MẺ CÔNG NGHIỆP - BIẾN MÔI TRƯỜNG MẪU (.env.example)
# Sao chép tệp này thành .env trước khi khởi chạy hệ thống:
# cp .env.example .env
# ==============================================================================

# Cấu hình cổng chạy Backend Core
PORT=4000

# Kết nối cơ sở dữ liệu PostgreSQL (Khớp với docker/docker-compose.dev.yml)
DATABASE_URL="postgresql://scale_admin:scale_secret_pass@localhost:5432/weighstation_db?schema=public"

# Kết nối Redis Cache & Pub/Sub
REDIS_HOST=localhost
REDIS_PORT=6379

# Kết nối MQTT Broker (EMQX) cho các máy Hub và đầu cân
MQTT_BROKER_URL=mqtt://localhost:1883
MQTT_USERNAME=hub_client
MQTT_PASSWORD=hub_secret_password

# Cấu hình Web Dashboard (Next.js)
NEXT_PUBLIC_API_URL=http://localhost:4000
