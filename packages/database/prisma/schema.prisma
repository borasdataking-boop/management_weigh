datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ==========================================
// 1. SUPERADMIN & MULTI-TENANT LAYER
// (Superadmin quản lý các Công ty khách hàng mua phần mềm)
// ==========================================

model Company {
  id        String   @id @default(uuid()) @db.Uuid
  code      String   @unique @db.VarChar(50) // VD: 'MINHPHU-SEAFOOD', 'SAOTA-FOODS'
  name      String   @db.VarChar(255)
  status    String   @default("ACTIVE") @db.VarChar(20)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  // Relationships
  hubs       Hub[]
  weightLogs ProductionWeightLog[]

  @@map("companies")
}

// ==========================================
// 2. EDGE HUB LAYER (Máy Hub tại xưởng chế biến)
// ==========================================

model Hub {
  id              String    @id @default(uuid()) @db.Uuid
  companyId       String    @map("company_id") @db.Uuid
  code            String    @unique @db.VarChar(50) // VD: 'HUB-XUONG-01'
  name            String    @db.VarChar(150) // VD: 'Máy Hub Quản lý Xưởng 1'
  ipAddress       String?   @map("ip_address") @db.VarChar(45)
  status          String    @default("ONLINE") @db.VarChar(20) // 'ONLINE' | 'OFFLINE'
  lastSeenAt      DateTime? @map("last_seen_at") @db.Timestamptz
  firmwareVersion String?   @default("v2.1-DINI") @map("firmware_version") @db.VarChar(50)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  // Relationships
  company    Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  stations   StationWeigh[]
  operators  PmshubOperator[]
  weightLogs ProductionWeightLog[]

  @@index([companyId])
  @@map("hubs")
}

// ==========================================
// 3. PMSL CORE MASTER DATA (Công đoạn, Sản phẩm, Định tuyến)
// ==========================================

model Process {
  processId   String   @id @map("process_id") @db.VarChar(50)
  processName String   @map("process_name") @db.VarChar(100)

  // Relationships
  stations   StationWeigh[]
  weightLogs ProductionWeightLog[]

  @@map("process")
}

model Product {
  productId   String   @id @map("product_id") @db.VarChar(50)
  productName String   @map("product_name") @db.VarChar(100)
  isEnd       Boolean? @default(false) @map("is_end")

  // Relationships
  weightLogs ProductionWeightLog[]

  @@map("product")
}

model MappingProcess {
  mappingId     Int    @id @default(autoincrement()) @map("mapping_id")
  fromProcessId String @map("from_process_id") @db.VarChar(50)
  toProcessId   String @map("to_process_id") @db.VarChar(50)

  @@map("mapping_process")
}

// ==========================================
// 4. PMSL TRẠM CÂN KẾT NỐI ĐẦU CÂN DINI & LOADCELL TẠI XƯỞNG
// ==========================================

model StationWeigh {
  stationId      String    @id @map("station_id") @db.VarChar(50)
  stationName    String    @map("station_name") @db.VarChar(100)
  processId      String    @map("process_id") @db.VarChar(50)
  hubId          String?   @map("hub_id") @db.Uuid // Máy Hub tại xưởng quản lý trạm này
  indicatorModel String    @default("DINI_ARGEO") @map("indicator_model") @db.VarChar(50) // Đầu cân Dini qua Loadcell
  isActive       Boolean   @default(true) @map("is_active")
  lastSeenAt     DateTime? @map("last_seen_at") @db.Timestamptz
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz

  // Relationships
  process    Process               @relation(fields: [processId], references: [processId], onDelete: Cascade)
  hub        Hub?                  @relation(fields: [hubId], references: [id], onDelete: SetNull)
  weightLogs ProductionWeightLog[]

  @@index([processId], name: "station_weigh_process_idx")
  @@index([hubId])
  @@map("station_weigh")
}

// ==========================================
// 5. PMSL OPERATOR TẠI MÁY HUB XƯỞNG
// ==========================================

model PmshubOperator {
  operatorId     BigInt    @id @default(autoincrement()) @map("operator_id")
  hubId          String?   @map("hub_id") @db.Uuid
  username       String    @unique @db.VarChar(64)
  passwordHash   String    @map("password_hash")
  isActive       Boolean   @default(true) @map("is_active")
  authVersion    Int       @default(1) @map("auth_version")
  failedAttempts Int       @default(0) @map("failed_attempts")
  lockedUntil    DateTime? @map("locked_until") @db.Timestamptz
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz
  lastLoginAt    DateTime? @map("last_login_at") @db.Timestamptz

  // Relationships
  hub Hub? @relation(fields: [hubId], references: [id], onDelete: SetNull)

  @@map("pmshub_operator")
}

// ==========================================
// 6. PMSL PRODUCTION WEIGHT LOGS (Nhật ký cân IN/OUT từ Loadcell & DINI)
// ==========================================

model ProductionWeightLog {
  logId           BigInt   @id @default(autoincrement()) @map("log_id")
  companyId       String?  @map("company_id") @db.Uuid
  hubId           String?  @map("hub_id") @db.Uuid
  batchId         String   @map("batch_id") @db.VarChar(50)
  stationId       String   @map("station_id") @db.VarChar(50)
  processId       String   @map("process_id") @db.VarChar(50)
  productId       String   @map("product_id") @db.VarChar(50)
  typeWeight      String   @map("type_weight") @db.VarChar(10) // 'IN' | 'OUT'
  valueWeight     Decimal  @map("value_weight") @db.Decimal(12, 3) // Khối lượng tổng từ Loadcell & DINI
  tareWeight      Decimal  @default(0) @map("tare_weight") @db.Decimal(12, 3) // Bì khay/rổ
  timeAction      DateTime @default(now()) @map("time_action") @db.Timestamptz
  employeeId      String?  @map("employee_id") @db.VarChar(50)
  sourceMessageId String?  @map("source_message_id") @db.VarChar(150)

  // Relationships
  company Company?      @relation(fields: [companyId], references: [id], onDelete: SetNull)
  hub     Hub?          @relation(fields: [hubId], references: [id], onDelete: SetNull)
  process Process?      @relation(fields: [processId], references: [processId], onDelete: SetNull)
  station StationWeigh? @relation(fields: [stationId], references: [stationId], onDelete: SetNull)
  product Product?      @relation(fields: [productId], references: [productId], onDelete: SetNull)

  @@unique([stationId, sourceMessageId], name: "ux_weight_logs_station_message")
  @@index([companyId])
  @@index([hubId])
  @@index([batchId])
  @@index([processId])
  @@index([stationId])
  @@index([timeAction])
  @@map("production_weight_logs")
}
